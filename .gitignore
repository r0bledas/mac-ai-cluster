# OS files
.DS_Store
Thumbs.db
*.swp
*~

# Build artifacts & libraries
build/
dist/
*.o
*.a
*.dylib
*.so
*.dll
*.exe

# Prebuilt binary folder (keep README.md and .gitkeep, ignore compiled binaries)
bin/*
!bin/README.md
!bin/.gitkeep

# Large model files & quantizations (keep README.md, ignore model weights)
models/*.gguf
models/*.bin
models/*.safetensors
*.gguf
*.bin
*.safetensors
!models/README.md
!models/.gitkeep

# Cloned sub-repositories (built locally)
llama.cpp/
exo/

# Python cache & offline wheel packages (keep README.md, ignore wheel binaries)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
offline_wheels/*.whl
!offline_wheels/README.md
!offline_wheels/.gitkeep

# Logs & temporary runtime files
*.log
*.err
/tmp/
